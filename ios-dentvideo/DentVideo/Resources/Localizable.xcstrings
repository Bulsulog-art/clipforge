    "That email and password don't match a DentVideo account.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-posta ve şifre bir DentVideo hesabıyla eşleşmiyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail und Passwort passen zu keinem DentVideo-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese email y contraseña no corresponden a una cuenta de DentVideo."
          }
        }
      }
    },
    "The video stays unused. Your note helps DentVideo choose better topics for your clinic.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video kullanılmaz. Notunuz, DentVideo'nun kliniğiniz için daha iyi konular seçmesine yardım eder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video wird nicht verwendet. Ihre Notiz hilft DentVideo, bessere Themen für Ihre Praxis zu wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo no se usará. Tu nota ayuda a DentVideo a elegir mejores temas para tu clínica."
          }
        }
      }
    },
    "These are DentVideo's sample videos. A clinic's real week has five, with its own logo and colours. Your choices here stay on this phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar DentVideo'nun örnek videolarıdır. Bir kliniğin gerçek haftasında, kendi logosu ve renkleriyle beş video olur. Buradaki seçimleriniz bu telefonda kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind DentVideos Beispielvideos. Eine echte Praxiswoche hat fünf, mit eigenem Logo und eigenen Farben. Ihre Auswahl bleibt auf diesem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos son los vídeos de ejemplo de DentVideo. Una semana real tiene cinco, con el logo y los colores de la clínica. Tus elecciones se quedan en este teléfono."
          }
        }
      }
    },
    "This clinic has no videos to review yet. When videos are made for your clinic, they appear here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klinik için henüz incelenecek video yok. Kliniğiniz için videolar hazırlandığında burada görünür."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Praxis gibt es noch keine Videos zur Prüfung. Sobald Videos für Ihre Praxis erstellt sind, erscheinen sie hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clínica aún no tiene vídeos para revisar. Cuando se preparen vídeos para tu clínica, aparecerán aquí."
          }
        }
      }
    },
    "This login has no DentVideo clinic. Use the email your clinic signed up with.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu girişe bağlı bir DentVideo kliniği yok. Kliniğinizin kayıt olduğu e-postayı kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu diesem Login gehört keine DentVideo-Praxis. Verwenden Sie die E-Mail, mit der sich Ihre Praxis registriert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este acceso no tiene una clínica de DentVideo. Usa el email con el que se registró tu clínica."
          }
        }
      }
    },
    "This permanently deletes your clinic, its videos and your login. If your subscription is active, it is cancelled first. This cannot be undone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem kliniğinizi, videolarını ve girişinizi kalıcı olarak siler. Aboneliğiniz etkinse önce iptal edilir. Geri alınamaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden Ihre Praxis, ihre Videos und Ihr Login dauerhaft gelöscht. Ein aktives Abo wird zuerst gekündigt. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina para siempre tu clínica, sus vídeos y tu acceso. Si tu suscripción está activa, primero se cancela. No se puede deshacer."
          }
        }
      }
    },
    "This video is still being made.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video hâlâ hazırlanıyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video wird noch erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo aún se está preparando."
          }
        }
      }
    },
    "This video won't be used. Changed your mind?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video kullanılmayacak. Fikrinizi mi değiştirdiniz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video wird nicht verwendet. Haben Sie es sich anders überlegt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo no se usará. ¿Cambiaste de idea?"
          }
        }
      }
    },
    "This week": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
