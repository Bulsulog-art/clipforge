            "value": "DentVideo"
          }
        }
      }
    },
    "DentVideo has paused this clinic's videos. Write to hello@dentvideo.com if this is unexpected.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo bu kliniğin videolarını durdurdu. Beklemediyseniz hello@dentvideo.com adresine yazın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo hat die Videos dieser Praxis pausiert. Schreiben Sie an hello@dentvideo.com, falls das unerwartet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo ha pausado los vídeos de esta clínica. Escribe a hello@dentvideo.com si no lo esperabas."
          }
        }
      }
    },
    "Don't use this one": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kullanma"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses nicht verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No usar este"
          }
        }
      }
    },
    "Don't use this video": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video kullanılmasın"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video nicht verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No usar este vídeo"
          }
        }
      }
    },
    "Every Monday, five short narrated videos with your logo and colours.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her pazartesi logonuz ve renklerinizle beş kısa, seslendirilmiş video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Montag fünf kurze, vertonte Videos mit Ihrem Logo und Ihren Farben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada lunes, cinco vídeos cortos narrados con tu logo y tus colores."
          }
        }
      }
    },
    "Every script is software-checked for accuracy and health-advertising rules before you see it. You decide what is used.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her metin, siz görmeden önce doğruluk ve sağlık reklamı kurallarına göre yazılımla denetlenir. Hangisinin kullanılacağına siz karar verirsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Skript wird vor Ihnen per Software auf Richtigkeit und Heilmittelwerberecht geprüft. Sie entscheiden, was verwendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada guion se revisa por software (precisión y normas de publicidad sanitaria) antes de que lo veas. Tú decides qué se usa."
          }
        }
      }
    },
    "Explore a sample clinic": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnek kliniği keşfedin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispielpraxis ansehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorar una clínica de ejemplo"
          }
        }
      }
    },
    "Forgot your password?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrenizi mi unuttunuz?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwort vergessen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Olvidaste tu contraseña?"
          }
        }
      }
    },
    "General patient information, not a diagnosis. Nothing is shared until your dentist approves it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel hasta bilgilendirmesidir, teşhis değildir. Diş hekiminiz onaylamadan hiçbir şey paylaşılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemeine Patienteninformation, keine Diagnose. Nichts wird geteilt, bevor Ihr Zahnarzt es freigibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información general para pacientes, no un diagnóstico. No se comparte nada hasta que tu dentista lo apruebe."
          }
        }
      }
    },
