    "Undo approval": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayı geri al"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe zurücknehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer aprobación"
          }
        }
      }
    },
    "Use the email and password your clinic uses on dentvideo.com.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniğinizin dentvideo.com'da kullandığı e-posta ve şifreyi kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die E-Mail und das Passwort Ihrer Praxis von dentvideo.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el email y la contraseña de tu clínica en dentvideo.com."
          }
        }
      }
    },
    "Videos": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videolar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos"
          }
        }
      }
    },
    "Watch each one, or approve them all if you have already checked them.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her birini izleyin ya da zaten kontrol ettiyseniz hepsini onaylayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie sich jedes an, oder geben Sie alle frei, wenn Sie sie schon geprüft haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cada uno, o apruébalos todos si ya los revisaste."
          }
        }
      }
    },
    "Week of %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ haftası"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Woche vom %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana del %@"
          }
        }
      }
    },
    "What should change? (optional)": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne değişmeli? (isteğe bağlı)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll anders sein? (optional)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué debería cambiar? (opcional)"
          }
        }
      }
    },
    "Your clinic's videos are being prepared. They appear here as soon as they are ready, every Monday.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniğinizin videoları hazırlanıyor. Hazır olur olmaz, her pazartesi burada görünür."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Videos Ihrer Praxis werden vorbereitet. Sie erscheinen hier, sobald sie fertig sind, jeden Montag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos de tu clínica se están preparando. Aparecen aquí en cuanto están listos, cada lunes."
          }
        }
      }
    },
    "Your clinic's weekly patient-education videos. Watch them, approve them, and post them from your own accounts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniğinizin haftalık hasta bilgilendirme videoları. İzleyin, onaylayın ve kendi hesaplarınızdan paylaşın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die wöchentlichen Patientenaufklärungsvideos Ihrer Praxis. Ansehen, freigeben und über Ihre eigenen Konten posten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos semanales de educación para pacientes de tu clínica. Míralos, apruébalos y publícalos desde tus propias cuentas."
          }
        }
      }
    },
    "Your note: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notunuz: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Notiz: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nota: %@"
          }
        }
      }
    },
    "Your past weeks will appear here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş haftalarınız burada görünecek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre vergangenen Wochen erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus semanas anteriores aparecerán aquí."
          }
        }
      }
    },
    "Your videos are paused.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videolarınız durduruldu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Videos sind pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus vídeos están en pausa."
          }
        }
      }
    },
