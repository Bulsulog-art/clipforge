{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%lld videos are waiting for your approval.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld video onayınızı bekliyor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Videos warten auf Ihre Freigabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld vídeos esperan tu aprobación."
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta"
          }
        }
      }
    },
    "Active": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa"
          }
        }
      }
    },
    "All set for this week. Approved videos are ready to post.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta tamam. Onaylanan videolar paylaşıma hazır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Woche ist alles erledigt. Freigegebene Videos sind bereit zum Posten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo listo esta semana. Los vídeos aprobados están listos para publicar."
          }
        }
      }
    },
    "Allow DentVideo to add to Photos in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar'dan DentVideo'nun Fotoğraflar'a eklemesine izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie DentVideo in den Einstellungen, Videos zu Fotos hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite en Ajustes que DentVideo añada vídeos a Fotos."
          }
        }
      }
    },
    "Approve": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar"
          }
        }
      }
    },
    "Approve all %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld videonun hepsini onayla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld freigeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar los %lld"
          }
        }
      }
    },
    "Approve it after all": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine de onayla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doch freigeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobarlo de todos modos"
          }
        }
      }
    },
    "Approved": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylandı"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigegeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobado"
          }
        }
      }
    },
    "Approved videos are posted from your own clinic accounts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylanan videoları kliniğinizin kendi hesaplarından paylaşırsınız."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigegebene Videos posten Sie über die Konten Ihrer Praxis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicas los vídeos aprobados desde las cuentas de tu clínica."
          }
        }
      }
    },
