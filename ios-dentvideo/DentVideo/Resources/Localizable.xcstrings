    "Couldn't prepare the video. Please try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video hazırlanamadı. Lütfen tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video konnte nicht vorbereitet werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar el vídeo. Inténtalo de nuevo."
          }
        }
      }
    },
    "Couldn't save the video. Please try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video kaydedilemedi. Lütfen tekrar deneyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video konnte nicht gespeichert werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el vídeo. Inténtalo de nuevo."
          }
        }
      }
    },
    "Couldn't update": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellenemedi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisierung fehlgeschlagen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar"
          }
        }
      }
    },
