# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://clipforge.bulsulabs.com
NEXT_PUBLIC_APP_NAME=ClipForge

# --- RevenueCat ---
NEXT_PUBLIC_REVENUECAT_PUBLIC_WEB_KEY=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=

# --- AI ---
OPENAI_API_KEY=
FAL_KEY=

# --- Social publishers ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Worker queue ---
REDIS_URL=redis://localhost:6379
WORKER_INTERNAL_TOKEN=

# --- Email ---
RESEND_API_KEY=

# ============================================================================
# DentVideo — every variable the web app (web/src) and worker (worker/src) read
# for DentVideo. The compose file loads both services from this file. Commented
# lines show the default. Security notes: docs/SECURITY.md (§5, §6).
# ============================================================================

# --- DentVideo backend: Liman (self-hosted Supabase, shared with other apps) ---
NEXT_PUBLIC_DENTVID_SUPABASE_URL=          # web + browser: Liman's public URL
NEXT_PUBLIC_DENTVID_SUPABASE_ANON_KEY=     # web + browser: anon key (public by design)
DENTVID_SUPABASE_URL=                      # worker: Liman URL (may be the internal one)
DENTVID_SERVICE_ROLE_KEY=                  # web + worker: service role — server only, never NEXT_PUBLIC
# HMAC key for the 6-digit email codes (lib/dentvid/verify-email). REQUIRED in
# production: unset, it falls back to DENTVID_SERVICE_ROLE_KEY and logs a
# SECURITY warning once per process. Any long random string (openssl rand -hex 32);
# changing it only voids codes waiting at that moment (15-minute life).
DENTVIDEO_VERIFY_SECRET=

# --- DentVideo site ---
NEXT_PUBLIC_DENTVIDEO_URL=https://dentvideo.com   # canonical host; unset = served under /dentvideo on NEXT_PUBLIC_APP_URL
DENTVIDEO_APP_URL=https://dentvideo.com           # worker: links in emails/digest
# DENTVIDEO_LEGAL_PAGES=on                 # show the sign-up consent line linking /terms and /privacy (only once those pages exist)
# DENTVIDEO_GOOGLE_SITE_VERIFICATION=
# DENTVIDEO_BING_SITE_VERIFICATION=
# DENTVIDEO_DEV_PREVIEW=1                  # enables /dentvideo/dev/* previews — NEVER in production

# --- Sign-up bot check: Cloudflare Turnstile (optional; off when unset) ---
# Set BOTH or neither: the site key shows the widget, the secret verifies it
# server-side (fail-closed while set). The CSP allows challenges.cloudflare.com
# only when the site key is set (build-time: NEXT_PUBLIC_ is baked in).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TRUST_CF_CONNECTING_IP=1                 # only once the origin accepts Cloudflare IPs only

# --- DentVideo owner dashboard (/dentvideo/admin) ---
# Liman auth user UUIDs (comma-separated) allowed to open the dashboard; everyone
# else gets a 404. Ids, not emails: sign-up does not verify email addresses.
# Find an id in Liman Studio → Authentication → Users, or:
#   select id, email from auth.users where email = 'owner@…';
DENTVIDEO_ADMIN_USER_IDS=

# --- DentVideo email (Resend: RESEND_API_KEY above) ---
# DENTVIDEO_EMAIL_FROM=DentVideo <hello@dentvideo.com>
# DENTVIDEO_EMAIL_REPLY_TO=hello@dentvideo.com
# Lifecycle email (welcome + unpaid-clinic reminders, lib/dentvid/lifecycle.ts).
# Signs one-click unsubscribe links; falls back to WORKER_INTERNAL_TOKEN.
DENTVIDEO_UNSUBSCRIBE_SECRET=
# DENTVIDEO_LIFECYCLE_EMAILS=off        # kill switch
# DENTVIDEO_LIFECYCLE_MAX_PER_RUN=50

# --- DentVideo billing (Dodo; same account as ClipForge: DODO_API_KEY, DODO_WEBHOOK_SECRET) ---
# DODO_API_KEY=                          # unset = static payment links, no in-app cancel
# DODO_WEBHOOK_SECRET=
# DODO_ENVIRONMENT=live                  # anything else = test mode
# DENTVIDEO_DODO_BRAND_ID=               # default: the DentVideo brand id in lib/dentvid/billing.ts
# DENTVIDEO_DODO_PRODUCT_STARTER_MONTHLY=   # each defaults to the live product id in billing.ts
# DENTVIDEO_DODO_PRODUCT_PRACTICE_MONTHLY=
# DENTVIDEO_DODO_PRODUCT_GROUP_MONTHLY=
# DENTVIDEO_DODO_PRODUCT_STARTER_YEARLY=
# DENTVIDEO_DODO_PRODUCT_PRACTICE_YEARLY=
# DENTVIDEO_DODO_PRODUCT_GROUP_YEARLY=
# DENTVIDEO_FOUNDING_OFFER=on            # "off" once the founding places are taken
# DENTVIDEO_FOUNDING_CODE=KURUCU100

# --- DentVideo owner alerts + daily digest (lib/dentvid/ops-alert.ts, shared with the worker) ---
# Where alerts go (worker AND web read it; both share this env file). Unset = alerts only logged.
OWNER_ALERT_EMAIL=
# DENTVID_OWNER_ALERTS=off              # kill switch: no alert emails, no digest (self-healing still runs)
# DENTVID_ALERT_MAX_PER_HOUR=8          # storm cap: past it, one "muted" note until the next hour
# DENTVID_ALERT_WEBHOOK_SIG_PER_HOUR=5  # Dodo signature failures before an alert
# DENTVID_ALERT_EMAIL_FAIL_PER_HOUR=3   # Resend failures before an alert
# DENTVID_ALERT_RENDER_FAIL_PER_HOUR=5  # video render failures before an alert (worker)
# DENTVID_ALERT_5XX_PER_HOUR=10         # server errors before an alert
# DENTVID_FIRST_WEEK_REQUEUE_MIN=45     # first week missing → re-queued automatically (worker)
# DENTVID_FIRST_WEEK_ALERT_MIN=120      # … and the owner told

# --- DentVideo worker: spend guard and capacity (worker/src/dentvid/spend-guard.ts) ---
# DENTVID_PAUSE_GENERATION=1            # kill switch for all DentVideo paid work
# DENTVID_DAILY_USD_CAP=20
# DENTVID_MONTHLY_USD_CAP=300
# DENTVID_DAILY_USD_PER_ACTIVE_CLINIC=1.15
# DENTVID_MONTHLY_USD_PER_ACTIVE_CLINIC=5.15
# DENTVID_CLINIC_DAILY_USD_CAP=5
# DENTVID_MAX_WEEKS_PER_CLINIC_WEEK=6
# DENTVID_MAX_RESTYLES_PER_CLINIC_DAY=10
# DENTVID_MAX_RECORDINGS_PER_CLINIC_WEEK=5
# DENTVID_MAX_RECORDING_MIN=30
# DENTVID_COST_WEEK_USD=0.50
# DENTVID_COST_RESTYLE_USD=0.03
# DENTVID_COST_RECORDING_USD=0.50
# DENTVID_COST_TOPUP_USD=0.30
# DENTVID_PARK_RESUME_MIN=15
# DENTVID_CONCURRENCY=1
# REMOTION_CONCURRENCY= / GENERATE_CONCURRENCY=   # render capacity (worker/src/remotion/capacity.ts)

# --- DentVideo worker: models and assets ---
# DENTVID_AGENT_MODEL= / DENTVID_REVIEW_MODEL=    # defaults in worker/src/dental/llm.ts
# DENTVID_JUDGE_MODEL=gpt-4o                      # eval only
# DENTVID_TTS_MODEL=tts-1-hd                      # DENTVID_TTS_MODEL_<LANG> overrides per language (e.g. _TR)
# DENTVID_BACKGROUNDS_DIR=                        # local background photos; else downloaded from
# DENTVID_BACKGROUNDS_BASE_URL=https://dentvideo.com
