    "forgot.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your email. We'll send you a link to choose a new password on dentvideo.com, then sign in here with it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihre E-Mail ein. Wir senden Ihnen einen Link, mit dem Sie auf dentvideo.com ein neues Passwort wählen. Danach melden Sie sich hier damit an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tu correo. Te enviaremos un enlace para elegir una contraseña nueva en dentvideo.com y después iniciar sesión aquí con ella."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postanızı girin. dentvideo.com'da yeni şifre belirlemeniz için bir bağlantı göndereceğiz; ardından buradan o şifreyle giriş yapabilirsiniz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre e-mail. Nous vous enverrons un lien pour choisir un nouveau mot de passe sur dentvideo.com, puis connectez-vous ici avec celui-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスを入力してください。dentvideo.comで新しいパスワードを設定するためのリンクをお送りします。設定後、こちらでサインインしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل بريدك الإلكتروني. سنرسل لك رابطًا لاختيار كلمة مرور جديدة على dentvideo.com، ثم سجّل الدخول بها هنا."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj swój e-mail. Wyślemy link do ustawienia nowego hasła na dentvideo.com, a potem zalogujesz się nim tutaj."
          }
        }
      }
    },
