    "code.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't find it? Check your spam folder. The code works for 15 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gefunden? Sehen Sie im Spam-Ordner nach. Der Code gilt 15 Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo encuentras? Revisa la carpeta de spam. El código vale durante 15 minutos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulamadınız mı? Spam klasörünüzü kontrol edin. Kod 15 dakika geçerlidir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne le trouvez pas ? Regardez dans vos spams. Le code est valable 15 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つからない場合は迷惑メールフォルダをご確認ください。コードの有効期限は15分です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تجدوه؟ تحقّقوا من مجلد الرسائل غير المرغوب فيها. الرمز صالح لمدة 15 دقيقة."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie widzą go Państwo? Prosimy sprawdzić folder spam. Kod jest ważny 15 minut."
          }
        }
      }
