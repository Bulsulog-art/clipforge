    "videos.closing.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goes under every caption. It is checked against your country's advertising rules when you save."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht unter jeder Bildunterschrift. Beim Sichern wird er gegen die Werberegeln Ihres Landes geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va debajo de cada texto. Al guardar se comprueba con las normas de publicidad de tu país."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her açıklamanın altına eklenir. Kaydederken ülkenizin reklam kurallarına göre kontrol edilir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutée sous chaque légende. Elle est vérifiée selon les règles publicitaires de votre pays à l'enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのキャプションの最後に入ります。保存時に国の広告ルールに照らしてチェックします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف أسفل كل نص، ويتم التحقق منها وفق قواعد الإعلان في بلدك عند الحفظ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawia się pod każdym opisem. Przy zapisie jest sprawdzane pod kątem zasad reklamy w Twoim kraju."
          }
        }
      }
    },
