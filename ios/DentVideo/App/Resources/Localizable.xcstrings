            "value": "Bu, hesabın planına dahil değil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci n'est pas inclus dans le forfait de ce compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのプランには含まれていません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا غير مشمول في خطة هذا الحساب."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest częścią planu tego konta."
          }
        }
      }
    },
    "error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. Please try again when you're online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Bitte versuchen Sie es erneut, sobald Sie online sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Inténtalo de nuevo cuando tengas conexión."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok. Çevrimiçi olduğunuzda tekrar deneyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion. Réessayez une fois en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できません。オンラインになってからもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال. حاول مجددًا عند الاتصال بالإنترنت."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia. Spróbuj ponownie, gdy będziesz online."
          }
        }
      }
    },
    "error.tooMany": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts in a short time. Please wait a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche in kurzer Zeit. Bitte warten Sie einen Moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos en poco tiempo. Espera un momento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa sürede çok fazla deneme yapıldı. Lütfen biraz bekleyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives en peu de temps. Patientez un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間に操作が多すぎます。少し待ってからお試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة في وقت قصير. يُرجى الانتظار قليلًا."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób w krótkim czasie. Poczekaj chwilę."
          }
        }
      }
    },
    "forgot.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your email. We'll send you a link to choose a new password on dentvideo.com, then sign in here with it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihre E-Mail ein. Wir senden Ihnen einen Link, mit dem Sie auf dentvideo.com ein neues Passwort wählen. Danach melden Sie sich hier damit an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tu correo. Te enviaremos un enlace para elegir una contraseña nueva en dentvideo.com y después iniciar sesión aquí con ella."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postanızı girin. dentvideo.com'da yeni şifre belirlemeniz için bir bağlantı göndereceğiz; ardından buradan o şifreyle giriş yapabilirsiniz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre e-mail. Nous vous enverrons un lien pour choisir un nouveau mot de passe sur dentvideo.com, puis connectez-vous ici avec celui-ci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスを入力してください。dentvideo.comで新しいパスワードを設定するためのリンクをお送りします。設定後、こちらでサインインしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل بريدك الإلكتروني. سنرسل لك رابطًا لاختيار كلمة مرور جديدة على dentvideo.com، ثم سجّل الدخول بها هنا."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj swój e-mail. Wyślemy link do ustawienia nowego hasła na dentvideo.com, a potem zalogujesz się nim tutaj."
          }
        }
      }
    },
