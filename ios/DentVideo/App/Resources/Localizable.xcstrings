    "signin.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your clinic's DentVideo account to review, approve and post your weekly videos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich mit dem DentVideo-Konto Ihrer Praxis an, um Ihre Videos der Woche zu prüfen, freizugeben und zu posten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con la cuenta de DentVideo de tu clínica para revisar, aprobar y publicar tus vídeos de la semana."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık videolarınızı incelemek, onaylamak ve paylaşmak için kliniğinizin DentVideo hesabıyla giriş yapın."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec le compte DentVideo de votre cabinet pour vérifier, valider et publier vos vidéos de la semaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医院のDentVideoアカウントでサインインすると、今週の動画を確認・承認・投稿できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول بحساب DentVideo الخاص بعيادتك لمراجعة فيديوهات الأسبوع والموافقة عليها ونشرها."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się kontem DentVideo swojego gabinetu, aby przejrzeć, zaakceptować i opublikować filmy z tego tygodnia."
          }
        }
      }
    },
