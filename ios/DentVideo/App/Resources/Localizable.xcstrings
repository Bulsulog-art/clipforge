{
  "sourceLanguage": "en",
  "strings": {
    "access.contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write to us"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie uns"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbenos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize yazın"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous écrire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お問い合わせ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راسلنا"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz do nas"
          }
        }
      }
    },
    "access.noClinic.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account doesn't have a clinic set up yet. Once it does, its videos appear here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Konto ist noch keine Praxis eingerichtet. Sobald das geschehen ist, erscheinen ihre Videos hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta aún no tiene una clínica configurada. Cuando la tenga, sus vídeos aparecerán aquí."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesapta henüz bir klinik kurulmamış. Kurulduğunda videoları burada görünür."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun cabinet n'est encore configuré pour ce compte. Dès que ce sera fait, ses vidéos apparaîtront ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにはまだ医院が設定されていません。設定されると、ここに動画が表示されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد عيادة لهذا الحساب بعد. عند إعدادها ستظهر فيديوهاتها هنا."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto nie ma jeszcze skonfigurowanego gabinetu. Gdy to nastąpi, jego filmy pojawią się tutaj."
          }
        }
      }
    },
    "access.noClinic.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clinic yet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Praxis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay clínica"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz klinik yok"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de cabinet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医院がまだありません"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عيادة بعد"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak gabinetu"
          }
        }
      }
    },
    "access.noPlan.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has no active plan at the moment, so there are no new videos to review here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto hat derzeit keinen aktiven Plan. Deshalb gibt es hier keine neuen Videos zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no tiene ningún plan activo en este momento, así que aquí no hay vídeos nuevos que revisar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın şu anda etkin bir planı yok; bu yüzden burada incelenecek yeni video bulunmuyor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n'a pas de forfait actif pour le moment : il n'y a donc pas de nouvelles vidéos à vérifier ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには現在有効なプランがないため、ここで確認する新しい動画はありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد لهذا الحساب خطة نشطة حاليًا، لذلك لا توجد فيديوهات جديدة للمراجعة هنا."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto nie ma obecnie aktywnego planu, więc nie ma tu nowych filmów do przejrzenia."
          }
        }
      }
    },
    "access.noPlan.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active plan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein aktiver Plan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin plan activo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin plan yok"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun forfait actif"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なプランはありません"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد خطة نشطة"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak aktywnego planu"
          }
        }
      }
    },
    "access.paused.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo has paused this account for now. Please write to %@ and we'll help."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo hat dieses Konto vorübergehend pausiert. Bitte schreiben Sie an %@, wir helfen Ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo ha pausado esta cuenta por ahora. Escríbenos a %@ y te ayudamos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo bu hesabı şimdilik duraklattı. Lütfen %@ adresine yazın, yardımcı olalım."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo a mis ce compte en pause pour le moment. Écrivez-nous à %@, nous vous aiderons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideoはこのアカウントを一時停止しています。%@ までご連絡ください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفت DentVideo هذا الحساب مؤقتًا. يُرجى مراسلتنا على %@ وسنساعدك."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo tymczasowo wstrzymało to konto. Napisz na %@, a pomożemy."
          }
        }
      }
    },
    "access.paused.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklatıldı"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف مؤقتًا"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane"
          }
        }
      }
    },
    "camera.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record, allow DentVideo to use the camera and microphone in iOS Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie DentVideo in den iOS-Einstellungen Kamera und Mikrofon, um aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar, permite a DentVideo usar la cámara y el micrófono en Ajustes de iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt için iOS Ayarları'ndan DentVideo'nun kamera ve mikrofonu kullanmasına izin verin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour filmer, autorisez DentVideo à utiliser la caméra et le micro dans les Réglages iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影するには、iOSの設定でDentVideoにカメラとマイクの使用を許可してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتسجيل، اسمح لـ DentVideo باستخدام الكاميرا والميكروفون من إعدادات iOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby nagrywać, zezwól DentVideo na użycie aparatu i mikrofonu w Ustawieniach iOS."
          }
        }
      }
    },
    "camera.denied.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera and microphone are off"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera und Mikrofon sind aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara y micrófono desactivados"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera ve mikrofon kapalı"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra et micro désactivés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラとマイクがオフです"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا والميكروفون معطّلان"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat i mikrofon są wyłączone"
          }
        }
      }
    },
    "camera.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera could not start. Close and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera konnte nicht starten. Schließen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la cámara. Cierra e inténtalo de nuevo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera başlatılamadı. Kapatıp tekrar deneyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra n'a pas pu démarrer. Fermez et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを起動できませんでした。閉じてもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تشغيل الكاميرا. أغلق وحاول مجددًا."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić aparatu. Zamknij i spróbuj ponownie."
          }
        }
      }
    },
