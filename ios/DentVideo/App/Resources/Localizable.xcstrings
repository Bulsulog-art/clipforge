    "settings.notifications.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The week-ready notice comes on Monday morning, at the same time as the email. Reminders are set on this phone only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilung zur fertigen Woche kommt am Montagmorgen, zur selben Zeit wie die E-Mail. Erinnerungen gelten nur auf diesem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aviso de semana lista llega el lunes por la mañana, a la vez que el correo. Los recordatorios solo se configuran en este teléfono."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta hazır bildirimi pazartesi sabahı, e-postayla aynı anda gelir. Hatırlatmalar yalnızca bu telefonda ayarlanır."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La notification « semaine prête » arrive le lundi matin, en même temps que l'e-mail. Les rappels ne concernent que ce téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了のお知らせは月曜の朝、メールと同時に届きます。リマインダーはこの端末だけに設定されます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل إشعار جاهزية الأسبوع صباح الاثنين مع البريد الإلكتروني. التذكيرات تُضبط على هذا الهاتف فقط."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienie o gotowym tygodniu przychodzi w poniedziałek rano, razem z e-mailem. Przypomnienia działają tylko na tym telefonie."
          }
        }
      }
    },
