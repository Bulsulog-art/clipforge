        }
      }
    },
    "topics.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions aren't available yet. Please write to us instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge sind noch nicht verfügbar. Schreiben Sie uns gern stattdessen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las propuestas aún no están disponibles. Escríbenos mientras tanto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneriler henüz kullanılamıyor. Bunun yerine bize yazabilirsiniz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les propositions ne sont pas encore disponibles. Écrivez-nous en attendant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマのご提案はまだご利用いただけません。お手数ですがメールでお知らせください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاقتراحات غير متاحة بعد. يمكنكم مراسلتنا بدلاً من ذلك."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Propozycje nie są jeszcze dostępne. Prosimy napisać do nas."
          }
        }
      }
    },
