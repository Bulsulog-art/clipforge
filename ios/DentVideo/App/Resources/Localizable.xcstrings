    "paywall.activating.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store has confirmed your payment. This usually takes a few seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat Ihre Zahlung bestätigt. Das dauert meist nur ein paar Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store ha confirmado tu pago. Esto suele tardar unos segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ödemenizi onayladı. Bu genellikle birkaç saniye sürer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
