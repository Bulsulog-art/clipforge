        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطّينا هذا الموضوع لأن النص لم يبلغ مستوى الجودة لدينا."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominęliśmy ten temat, ponieważ scenariusz nie spełnił naszych standardów jakości."
          }
        }
      }
    },
    "reason.technical": {
