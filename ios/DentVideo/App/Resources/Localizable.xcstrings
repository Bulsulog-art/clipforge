    "forgot.sent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an account exists for this email, the link is on its way. It works for a limited time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls zu dieser E-Mail ein Konto existiert, ist der Link unterwegs. Er ist nur begrenzte Zeit gültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
