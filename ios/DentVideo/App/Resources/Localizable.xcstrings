    "decline.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It won't be posted. A short note helps us make the next ones closer to what you want."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nicht gepostet. Eine kurze Notiz hilft uns, die nächsten Videos besser auf Sie abzustimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se publicará. Una nota breve nos ayuda a acercar los próximos a lo que buscas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılmayacak. Kısa bir not, sonraki videoları isteğinize yaklaştırmamıza yardımcı olur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne sera pas publiée. Une courte note nous aide à mieux viser les prochaines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画は投稿されません。ひと言いただけると、次の動画づくりに役立ちます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُنشر. تساعدنا ملاحظة قصيرة على جعل الفيديوهات القادمة أقرب إلى ما تريد."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zostanie opublikowany. Krótka notatka pomoże nam lepiej dopasować kolejne filmy."
          }
        }
      }
    },
