    "paywall.error.offers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store isn't answering right now. Please try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store antwortet gerade nicht. Bitte versuchen Sie es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no responde en este momento. Inténtalo de nuevo en un momento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store şu anda yanıt vermiyor. Lütfen birazdan tekrar deneyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store ne répond pas pour le moment. Réessayez dans un instant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在App Storeから応答がありません。少し時間をおいてもう一度お試しください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستجيب App Store حالياً. يُرجى المحاولة مجدداً بعد قليل."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie odpowiada w tej chwili. Prosimy spróbować ponownie za moment."
          }
        }
      }
    },
    "paywall.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Monday, five short narrated videos in your clinic's language and colors. Nothing is published without your approval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Montag fünf kurze, vertonte Videos in der Sprache und den Farben Ihrer Praxis. Nichts wird ohne Ihre Freigabe veröffentlicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada lunes, cinco vídeos cortos con locución en el idioma y los colores de tu clínica. Nada se publica sin tu aprobación."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her pazartesi kliniğinizin dilinde ve renklerinde beş kısa, seslendirilmiş video. Onayınız olmadan hiçbir şey yayımlanmaz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque lundi, cinq courtes vidéos commentées dans la langue et aux couleurs de votre cabinet. Rien n'est publié sans votre validation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週月曜日、医院の言語とカラーでナレーション付きの短い動画を5本お届けします。ご承認なしに公開されることはありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل يوم اثنين، خمسة فيديوهات قصيرة بتعليق صوتي بلغة عيادتكم وألوانها. لا يُنشر شيء دون موافقتكم."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co poniedziałek pięć krótkich filmów z lektorem w języku i barwach gabinetu. Nic nie zostanie opublikowane bez Państwa zgody."
          }
        }
      }
    },
    "paywall.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase is waiting for approval. Your plan starts as soon as the App Store confirms it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Kauf wartet auf Freigabe. Ihr Tarif beginnt, sobald der App Store ihn bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación. Tu plan empezará en cuanto el App Store la confirme."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alımınız onay bekliyor. App Store onayladığı anda planınız başlar."
          }
        },
        "fr": {
          "stringUnit": {
