    "change.error.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used this week's 3 change requests. You can ask again next week, or decline the video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben die 3 Änderungen dieser Woche genutzt. Nächste Woche können Sie wieder fragen, oder Sie lehnen das Video ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya usaste los 3 cambios de esta semana. Puedes pedir otro la semana que viene o descartar el vídeo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftaki 3 değişiklik hakkınızı kullandınız. Gelecek hafta yeniden isteyebilir ya da videoyu reddedebilirsiniz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez utilisé les 3 modifications de la semaine. Vous pourrez en demander d'autres la semaine prochaine, ou refuser la vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の修正依頼（3回）をすべて使いました。来週あらためてご依頼いただくか、動画を見送ってください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدمتم الحد الأسبوعي للتعديلات (3 تعديلات). يمكنكم الطلب من جديد الأسبوع القادم، أو رفض الفيديو."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystali Państwo 3 zmiany w tym tygodniu. Można poprosić ponownie w przyszłym tygodniu albo odrzucić film."
          }
        }
      }
    },
    "change.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change requests aren't available yet. Please write to us instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungsanfragen sind noch nicht verfügbar. Schreiben Sie uns gern stattdessen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios aún no están disponibles. Escríbenos mientras tanto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik istekleri henüz kullanılamıyor. Bunun yerine bize yazabilirsiniz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes de modification ne sont pas encore disponibles. Écrivez-nous en attendant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正の依頼はまだご利用いただけません。お手数ですがメールでお知らせください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلبات التعديل غير متاحة بعد. يمكنكم مراسلتنا بدلاً من ذلك."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prośby o zmianę nie są jeszcze dostępne. Prosimy napisać do nas."
          }
        }
      }
    },
    "change.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your note"
          }
        },
        "de": {
