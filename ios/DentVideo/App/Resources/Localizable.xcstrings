          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。診療内容に合い、チェックを通れば、今後の週のいずれかで制作します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكراً لكم. إذا ناسب خدماتكم واجتاز المراجعات، فسيكون في أحد الأسابيع القادمة."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy. Jeśli pasuje do Państwa zabiegów i przejdzie kontrole, pojawi się w jednym z najbliższych tygodni."
