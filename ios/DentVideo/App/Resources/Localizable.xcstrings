          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitimos este tema porque el guion no alcanzó nuestro nivel de calidad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konuyu atladık; senaryo kalite çıtamızı karşılamadı."
          }
        },
        "fr": {
