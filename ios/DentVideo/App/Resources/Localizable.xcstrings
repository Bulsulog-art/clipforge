    "post.error.photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo may not save to Photos. Allow it in iOS Settings, or use More apps to share the video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo darf nicht in Fotos sichern. Erlauben Sie es in den iOS-Einstellungen oder teilen Sie das Video über Weitere Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo no puede guardar en Fotos. Permítelo en Ajustes de iOS o usa Más apps para compartir el vídeo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo'nun Fotoğraflar'a kaydetme izni yok. iOS Ayarları'ndan izin verin ya da videoyu Diğer uygulamalar ile paylaşın."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo ne peut pas enregistrer dans Photos. Autorisez-le dans les Réglages iOS, ou partagez la vidéo via Autres apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideoに「写真」への保存が許可されていません。iOSの設定で許可するか、「その他のアプリ」から共有してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك DentVideo إذنًا بالحفظ في الصور. اسمح بذلك في إعدادات iOS، أو شارك الفيديو عبر تطبيقات أخرى."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DentVideo nie może zapisywać w Zdjęciach. Zezwól na to w Ustawieniach iOS albo udostępnij film przez Inne aplikacje."
          }
        }
      }
    },
