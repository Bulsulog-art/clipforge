          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeでお支払いが確認されました。通常は数秒で完了します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد App Store عملية الدفع. يستغرق ذلك عادةً بضع ثوانٍ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
