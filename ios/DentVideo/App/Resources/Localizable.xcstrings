    "record.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each card says what to say, in order. Record with the card on screen; we edit the clip, add captions and your logo, and check it like every video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Karte zeigt, was Sie in welcher Reihenfolge sagen. Nehmen Sie mit der Karte im Bild auf; wir schneiden den Clip, fügen Untertitel und Ihr Logo hinzu und prüfen ihn wie jedes Video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tarjeta indica qué decir y en qué orden. Graba con la tarjeta en pantalla; editamos el clip, añadimos subtítulos y tu logo, y lo revisamos como cada vídeo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kart, neyi hangi sırayla söyleyeceğinizi gösterir. Kart ekrandayken kaydedin; klibi düzenler, altyazı ve logonuzu ekler, her video gibi kontrol ederiz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fiche indique quoi dire, dans l'ordre. Filmez avec la fiche à l'écran ; nous montons le clip, ajoutons sous-titres et logo, et le vérifions comme chaque vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードには話す内容が順番に書かれています。カードを画面に表示したまま撮影してください。編集・字幕・ロゴ入れを行い、ほかの動画と同じようにチェックします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخبرك كل بطاقة بما تقوله وبالترتيب. سجّل والبطاقة على الشاشة؛ نحرر المقطع ونضيف الترجمة وشعارك ونراجعه مثل كل فيديو."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda karta mówi, co powiedzieć i w jakiej kolejności. Nagrywaj z kartą na ekranie; zmontujemy klip, dodamy napisy i logo oraz sprawdzimy go jak każdy film."
          }
        }
      }
    },
