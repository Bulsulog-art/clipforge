    "post.error.download": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video could not be downloaded. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video konnte nicht geladen werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el vídeo. Inténtalo de nuevo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video indirilemedi. Lütfen tekrar deneyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo n'a pas pu être téléchargée. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
