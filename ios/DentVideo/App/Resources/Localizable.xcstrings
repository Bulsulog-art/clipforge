    "plan.managedAppStore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Billed through your Apple ID. Change or cancel it in Apple's subscription settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgerechnet über Ihre Apple-ID. Ändern oder kündigen Sie es in den Abo-Einstellungen von Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se factura a través de tu Apple ID. Cámbialo o cancélalo en los ajustes de suscripciones de Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Kimliğiniz üzerinden faturalandırılır. Apple'ın abonelik ayarlarından değiştirebilir veya iptal edebilirsiniz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturé via votre identifiant Apple. Modifiez-le ou résiliez-le dans les réglages d'abonnement d'Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple IDで請求されます。変更や解約はAppleのサブスクリプション設定から行えます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم الفوترة عبر Apple ID. يمكنكم تغييره أو إلغاؤه من إعدادات الاشتراكات في Apple."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozliczane przez Apple ID. Można to zmienić lub anulować w ustawieniach subskrypcji Apple."
          }
        }
      }
    },
