    "forgot.sent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an account exists for this email, the link is on its way. It works for a limited time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls zu dieser E-Mail ein Konto existiert, ist der Link unterwegs. Er ist nur begrenzte Zeit gültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta con este correo, el enlace va de camino. Es válido durante un tiempo limitado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-postaya ait bir hesap varsa bağlantı yolda. Bağlantı sınırlı bir süre geçerlidir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe pour cet e-mail, le lien est en route. Il n'est valable que pendant une durée limitée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスのアカウントがあれば、リンクを送信しました。リンクの有効期間は限られています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان هناك حساب بهذا البريد، فالرابط في طريقه إليك. وهو صالح لمدة محدودة."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli istnieje konto dla tego e-maila, link jest w drodze. Działa przez ograniczony czas."
          }
        }
      }
    },
