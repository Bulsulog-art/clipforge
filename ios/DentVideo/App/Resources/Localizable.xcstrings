    "delete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your clinic's DentVideo account. It cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird das DentVideo-Konto Ihrer Praxis dauerhaft gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina para siempre la cuenta de DentVideo de tu clínica. No se puede deshacer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem kliniğinizin DentVideo hesabını kalıcı olarak siler. Geri alınamaz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement le compte DentVideo de votre cabinet. C'est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医院のDentVideoアカウントを完全に削除します。元に戻せません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف حساب DentVideo الخاص بعيادتك نهائيًا، ولا يمكن التراجع عنه."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usunie konto DentVideo Twojego gabinetu. Nie można tego cofnąć."
          }
        }
      }
    },
