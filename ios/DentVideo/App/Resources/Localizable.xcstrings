    "topics.error.tooManyPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have 5 suggestions waiting. We'll use those first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben schon 5 Vorschläge, die warten. Diese nutzen wir zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes 5 propuestas en espera. Usaremos esas primero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen 5 öneriniz var. Önce onları kullanacağız."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà 5 propositions en attente. Nous les utiliserons d'abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに5件のご提案が待機中です。そちらを先に使います。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
