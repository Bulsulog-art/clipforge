    "topics.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A patient question or a subject, in one sentence. We use suggestions first when they fit your services and pass the same checks as every video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Patientenfrage oder ein Thema, in einem Satz. Vorschläge nutzen wir zuerst, wenn sie zu Ihren Leistungen passen und dieselben Prüfungen bestehen wie jedes Video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pregunta de un paciente o un tema, en una frase. Usamos primero las propuestas que encajan con tus servicios y pasan las mismas revisiones que cada vídeo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hasta sorusu ya da bir konu, tek cümleyle. Önerileri, hizmetlerinize uyduğunda ve her video gibi aynı kontrollerden geçtiğinde önce kullanırız."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une question de patient ou un sujet, en une phrase. Nous utilisons d'abord les propositions qui correspondent à vos soins et passent les mêmes vérifications que chaque vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "患者さんの質問やテーマを一文でお書きください。登録された診療内容に合い、すべての動画と同じチェックを通ったものから優先して使います。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سؤال من مريض أو موضوع، في جملة واحدة. نستخدم الاقتراحات أولاً متى ناسبت خدماتكم واجتازت المراجعات نفسها التي يمرّ بها كل فيديو."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytanie pacjenta albo temat, w jednym zdaniu. Propozycje wykorzystujemy w pierwszej kolejności, jeśli pasują do zabiegów gabinetu i przechodzą te same kontrole co każdy film."
          }
        }
      }
    },
    "topics.listTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
