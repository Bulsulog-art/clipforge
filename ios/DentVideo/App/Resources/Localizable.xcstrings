    "change.reason.not_possible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video can't be changed this way. Write to us and we'll help."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Video lässt sich so nicht ändern. Schreiben Sie uns, wir helfen gern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este vídeo no se puede cambiar así. Escríbenos y te ayudamos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu video bu şekilde değiştirilemiyor. Bize yazın, yardımcı olalım."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vidéo ne peut pas être modifiée ainsi. Écrivez-nous, nous vous aiderons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画はこの方法では修正できません。メールでご連絡いただければお手伝いします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تعديل هذا الفيديو بهذه الطريقة. راسلونا وسنساعدكم."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego filmu nie można zmienić w ten sposób. Prosimy napisać do nas, pomożemy."
          }
        }
      }
    },
    "change.reason.technical": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on our side. Your current video stays, and we have been told."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei uns ist etwas schiefgegangen. Ihr bisheriges Video bleibt, und wir sind informiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo falló por nuestra parte. Tu vídeo actual se mantiene y ya estamos avisados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bizim tarafımızda bir sorun oldu. Mevcut videonuz duruyor ve bizim haberimiz var."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu de notre côté. Votre vidéo actuelle reste, et nous sommes prévenus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こちら側で問題が発生しました。現在の動画はそのまま残り、担当者にも連絡が届いています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ من جهتنا. يبقى الفيديو الحالي، وقد أُبلغنا بالأمر."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po naszej stronie coś poszło nie tak. Obecny film zostaje, a my już o tym wiemy."
          }
        }
      }
    },
