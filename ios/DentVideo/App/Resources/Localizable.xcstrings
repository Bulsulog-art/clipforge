          "stringUnit": {
            "state": "translated",
            "value": "Bald können Sie hier einen Tarif wählen. Fragen? Schreiben Sie uns an %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto podrás elegir un plan aquí. ¿Tienes preguntas? Escríbenos a %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakında buradan plan seçebileceksiniz. Sorularınız mı var? %@ adresine yazın."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez bientôt choisir une formule ici. Des questions ? Écrivez-nous à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近日中にこちらでプランを選べるようになります。ご質問は %@ までお寄せください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتمكّنون قريباً من اختيار خطة هنا. لديكم أسئلة؟ راسلونا على %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wkrótce będzie można wybrać tu plan. Pytania? Prosimy pisać na %@."
          }
        }
      }
    },
