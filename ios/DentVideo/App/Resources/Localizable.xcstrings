    "clinic.country.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The country decides which advertising rules your videos follow. To change it, write to us."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Land bestimmt, welchen Werberegeln Ihre Videos folgen. Für eine Änderung schreiben Sie uns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El país determina qué normas de publicidad siguen tus vídeos. Para cambiarlo, escríbenos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülke, videolarınızın hangi reklam kurallarına uyacağını belirler. Değiştirmek için bize yazın."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pays détermine les règles publicitaires que suivent vos vidéos. Pour le changer, écrivez-nous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国によって動画が従う広告ルールが決まります。変更はお問い合わせください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدد الدولة قواعد الإعلان التي تتبعها فيديوهاتك. لتغييرها، راسلنا."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraj decyduje, jakich zasad reklamy przestrzegają filmy. Aby go zmienić, napisz do nas."
          }
        }
      }
    },
