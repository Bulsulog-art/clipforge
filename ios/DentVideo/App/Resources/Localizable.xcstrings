    "reason.audio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound may be quiet in places. Have a listen before posting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ton ist stellenweise leise. Bitte vor dem Posten kurz anhören."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido puede ser bajo en algún momento: escúchalo antes de publicar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses bazı yerlerde düşük olabilir. Paylaşmadan önce dinleyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son peut être faible par endroits. Écoutez-le avant de publier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声が小さい箇所があるかもしれません。投稿前にお聞きください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون الصوت منخفضًا في بعض المواضع، لذا يُرجى الاستماع قبل النشر."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk może miejscami być cichy. Prosimy odsłuchać przed publikacją."
          }
        }
      }
    },
    "reason.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worth a quick look before posting."
          }
