            "value": "Notatka"
          }
        }
      }
    },
    "change.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the change in a sentence or two. Only this video is made again, with the same checks, and you approve it again before posting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie die Änderung in ein, zwei Sätzen. Nur dieses Video wird neu erstellt, mit denselben Prüfungen, und Sie geben es vor dem Posten erneut frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe el cambio en una o dos frases. Solo se vuelve a crear este vídeo, con las mismas revisiones, y lo apruebas de nuevo antes de publicarlo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliği bir iki cümleyle anlatın. Yalnızca bu video aynı kontrollerle yeniden hazırlanır ve paylaşmadan önce yeniden onaylarsınız."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez la modification en une ou deux phrases. Seule cette vidéo est refaite, avec les mêmes vérifications, et vous la validez à nouveau avant de la publier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更してほしい点を1〜2文でお書きください。この動画だけを同じチェックを通して作り直し、投稿前にもう一度ご承認いただきます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفوا التعديل في جملة أو جملتين. يُعاد إعداد هذا الفيديو وحده، مع المراجعات نفسها، وتعتمدونه من جديد قبل النشر."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosimy opisać zmianę w jednym lub dwóch zdaniach. Ponownie powstaje tylko ten film, z tymi samymi kontrolami, i przed publikacją trzeba go znów zatwierdzić."
          }
        }
      }
    },
    "change.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: Shorter, and say that sensitivity usually fades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel: Kürzer, und sagen, dass die Empfindlichkeit meist nachlässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo: Más corto, y que diga que la sensibilidad suele pasar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örneğin: Daha kısa olsun ve hassasiyetin genellikle geçtiğini söylesin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple : Plus courte, et dire que la sensibilité passe en général."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：もっと短く、しみる感じはたいてい治まると伝えてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلاً: أقصر، وأن يذكر أن الحساسية تزول عادةً."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na przykład: Krótszy, z informacją, że nadwrażliwość zwykle mija."
          }
        }
      }
    },
    "change.reason.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't make the change right now. Your current video stays, and we have been told."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten die Änderung gerade nicht erstellen. Ihr bisheriges Video bleibt, und wir sind informiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no pudimos hacer el cambio. Tu vídeo actual se mantiene y ya estamos avisados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliği şu anda yapamadık. Mevcut videonuz duruyor ve bizim haberimiz var."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu faire la modification pour l'instant. Votre vidéo actuelle reste, et nous sommes prévenus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、修正を作成できませんでした。現在の動画はそのまま残り、担当者にも連絡が届いています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من إجراء التعديل الآن. يبقى الفيديو الحالي، وقد أُبلغنا بالأمر."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz wprowadzić zmiany. Obecny film zostaje, a my już o tym wiemy."
          }
        }
      }
    },
    "change.reason.checks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The changed version didn't pass our checks, so your current video stays as it is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geänderte Fassung hat unsere Prüfungen nicht bestanden, daher bleibt Ihr bisheriges Video unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión cambiada no pasó nuestras revisiones, así que tu vídeo actual se queda como está."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirilmiş sürüm kontrollerimizden geçmedi; bu yüzden mevcut videonuz olduğu gibi kalıyor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version modifiée n'a pas passé nos vérifications : votre vidéo actuelle reste telle quelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正版がチェックを通らなかったため、現在の動画をそのまま残しています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تجتز النسخة المعدّلة مراجعاتنا، لذا يبقى الفيديو الحالي كما هو."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniona wersja nie przeszła naszych kontroli, dlatego obecny film zostaje bez zmian."
          }
        }
      }
    },
    "change.reason.no_plan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
