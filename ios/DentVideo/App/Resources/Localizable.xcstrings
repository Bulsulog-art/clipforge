    },
    "reason.opening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We took out the on-screen opening line to stay within advertising rules. Have a look before posting."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben die Einstiegszeile im Bild entfernt, damit alles im Rahmen des Werberechts bleibt. Bitte vor dem Posten kurz ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitamos la frase inicial en pantalla para respetar las normas de publicidad: échale un vistazo antes de publicar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam kurallarına uymak için ekrandaki açılış cümlesini çıkardık. Paylaşmadan önce göz atın."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons retiré la phrase d'accroche à l'écran pour rester dans les règles de publicité. Jetez-y un œil avant de publier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告ルールに沿うよう、画面上の冒頭の一文を外しました。投稿前にご確認ください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزلنا الجملة الافتتاحية على الشاشة للالتزام بقواعد الإعلان، لذا يُرجى إلقاء نظرة قبل النشر."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunęliśmy zdanie otwierające na ekranie, aby zachować zgodność z zasadami reklamy. Prosimy obejrzeć przed publikacją."
          }
        }
      }
    },
