    "primer.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We send one notification on Monday morning when your videos are ready, and, if you turn them on, a reminder at each video's posting time. Nothing else."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden eine Mitteilung am Montagmorgen, wenn Ihre Videos fertig sind, und auf Wunsch eine Erinnerung zur Posting-Zeit jedes Videos. Sonst nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos un aviso el lunes por la mañana cuando tus vídeos están listos y, si lo activas, un recordatorio a la hora de publicar cada vídeo. Nada más."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videolarınız hazır olduğunda pazartesi sabahı bir bildirim göndeririz; isterseniz her videonun paylaşım saatinde bir hatırlatma da. Başka bir şey değil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous envoyons une notification le lundi matin quand vos vidéos sont prêtes et, si vous l'activez, un rappel à l'heure de publication de chaque vidéo. Rien d'autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画ができた月曜の朝に1回お知らせします。オンにすれば、各動画の投稿時刻にもリマインダーが届きます。それ以外は送りません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نرسل إشعارًا واحدًا صباح الاثنين عندما تجهز فيديوهاتك، وإذا فعّلت ذلك، تذكيرًا في موعد نشر كل فيديو. لا شيء غير ذلك."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłamy jedno powiadomienie w poniedziałek rano, gdy filmy są gotowe, a jeśli zechcesz, przypomnienie o porze publikacji każdego filmu. Nic więcej."
          }
        }
      }
    },
