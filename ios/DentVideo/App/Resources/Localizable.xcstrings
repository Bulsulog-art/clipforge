    "camera.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch your take. Keep it, or record again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie sich die Aufnahme an. Behalten oder neu aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira la toma. Quédatela o graba de nuevo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekiminizi izleyin. Kullanın ya da yeniden çekin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez la prise. Gardez-la ou recommencez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮った動画を確認して、使うか撮り直すかを選んでください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد اللقطة، واحتفظ بها أو سجّل من جديد."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejrzyj ujęcie. Zachowaj je albo nagraj ponownie."
          }
        }
      }
    },
    "camera.showCard": {
      "extractionState": "manual",
      "localizations": {
