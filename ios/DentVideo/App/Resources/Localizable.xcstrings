            "state": "translated",
            "value": "This login has no DentVideo clinic. Please use the email you use for DentVideo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser Anmeldung gehört keine DentVideo-Praxis. Bitte nutzen Sie die E-Mail, mit der Sie DentVideo verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
