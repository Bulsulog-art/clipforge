        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte vor dem Posten kurz ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conviene echarle un vistazo antes de publicar."
          }
