    "topics.sent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you. If it fits your services and passes the checks, it will be in an upcoming week."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke. Passt er zu Ihren Leistungen und besteht er die Prüfungen, kommt er in einer der nächsten Wochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
