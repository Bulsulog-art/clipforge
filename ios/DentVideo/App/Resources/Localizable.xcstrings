    "record.noCards": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filming cards come with your weekly videos. You can also record without one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehkarten kommen mit Ihren Wochenvideos. Sie können auch ohne Karte aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas de grabación llegan con tus vídeos semanales. También puedes grabar sin tarjeta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekim kartları haftalık videolarınızla gelir. Kart olmadan da kayıt yapabilirsiniz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fiches de tournage arrivent avec vos vidéos de la semaine. Vous pouvez aussi filmer sans fiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影カードは毎週の動画と一緒に届きます。カードなしでも撮影できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل بطاقات التصوير مع فيديوهاتك الأسبوعية، ويمكنك أيضًا التسجيل بدون بطاقة."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty nagrań przychodzą razem z cotygodniowymi filmami. Możesz też nagrać bez karty."
          }
        }
      }
    },
    "record.notIncluded.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording yourself isn't part of this account's plan. Your weekly videos are not affected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Aufnahmen sind nicht Teil des Plans dieses Kontos. Ihre Wochenvideos sind davon nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabarte no forma parte del plan de esta cuenta. Tus vídeos semanales no se ven afectados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi kaydınızı yapmak bu hesabın planına dahil değil. Haftalık videolarınız bundan etkilenmez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous filmer ne fait pas partie du forfait de ce compte. Vos vidéos de la semaine ne sont pas concernées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身での撮影はこのアカウントのプランに含まれていません。毎週の動画には影響しません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل بنفسك ليس ضمن خطة هذا الحساب، ولا يؤثر ذلك على فيديوهاتك الأسبوعية."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie siebie nie jest częścią planu tego konta. Nie wpływa to na cotygodniowe filmy."
          }
        }
      }
    },
