      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video goes to Photos and the text to the clipboard. Then open the app you post with and paste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video landet in Fotos, der Text in der Zwischenablage. Öffnen Sie dann Ihre App und fügen Sie ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo va a Fotos y el texto al portapapeles. Después abre la app con la que publicas y pega."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Video Fotoğraflar'a, metin panoya gider. Sonra paylaştığınız uygulamayı açıp yapıştırın."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo va dans Photos et le texte dans le presse-papiers. Ouvrez ensuite votre app et collez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画は「写真」に、テキストはクリップボードに入ります。投稿に使うアプリを開いて貼り付けてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ الفيديو في الصور والنص في الحافظة. ثم افتح التطبيق الذي تنشر منه والصق."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Film trafi do Zdjęć, a tekst do schowka. Potem otwórz aplikację, w której publikujesz, i wklej."
