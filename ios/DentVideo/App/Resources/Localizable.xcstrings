    "clinic.country.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The country decides which advertising rules your videos follow. To change it, write to us."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Land bestimmt, welchen Werberegeln Ihre Videos folgen. Für eine Änderung schreiben Sie uns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El país determina qué normas de publicidad siguen tus vídeos. Para cambiarlo, escríbenos."
          }
        },
        "tr": {
