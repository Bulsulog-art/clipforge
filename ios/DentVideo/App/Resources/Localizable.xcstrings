    "paywall.confirming.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is taking longer than usual. You don't need to buy again: we'll email you as soon as your plan is active."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dauert länger als sonst. Sie müssen nichts erneut kaufen: Wir schreiben Ihnen eine E-Mail, sobald Ihr Tarif aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto está tardando más de lo habitual. No tienes que volver a comprar: te enviaremos un correo en cuanto tu plan esté activo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, her zamankinden uzun sürüyor. Tekrar satın almanız gerekmez: planınız etkinleşir etkinleşmez size e-posta göndereceğiz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela prend plus de temps que d'habitude. Inutile d'acheter à nouveau : nous vous écrirons dès que votre formule sera active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常より時間がかかっています。再度ご購入いただく必要はありません。プランが有効になり次第、メールでお知らせします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق هذا وقتاً أطول من المعتاد. لا حاجة إلى الشراء مرة أخرى: سنراسلكم بالبريد الإلكتروني فور تفعيل خطتكم."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa to dłużej niż zwykle. Nie trzeba kupować ponownie: wyślemy e-mail, gdy tylko plan będzie aktywny."
          }
        }
      }
    },
