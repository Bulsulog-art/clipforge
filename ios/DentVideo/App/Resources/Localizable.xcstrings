      }
    },
    "topics.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: How long does sensitivity last after whitening?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel: Wie lange hält die Empfindlichkeit nach dem Bleaching an?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo: ¿Cuánto dura la sensibilidad después de un blanqueamiento?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örneğin: Beyazlatmadan sonra hassasiyet ne kadar sürer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple : Combien de temps dure la sensibilité après un blanchiment ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：ホワイトニング後のしみる感じはどのくらい続きますか？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلاً: كم تستمر الحساسية بعد تبييض الأسنان؟"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na przykład: Jak długo utrzymuje się nadwrażliwość po wybielaniu?"
          }
        }
      }
    },
    "topics.reason.ad_rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It asks for something health-advertising rules restrict, such as prices, offers, comparisons or promised results."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verlangt etwas, das die Regeln für Heilmittelwerbung einschränken, etwa Preise, Angebote, Vergleiche oder versprochene Ergebnisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide algo que las normas de publicidad sanitaria restringen, como precios, ofertas, comparaciones o resultados prometidos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık reklamı kurallarının kısıtladığı bir şey istiyor; örneğin fiyat, kampanya, karşılaştırma ya da vaat edilen sonuç."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il demande quelque chose que les règles de publicité en santé restreignent, comme des prix, des offres, des comparaisons ou des résultats promis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料金、キャンペーン、他院との比較、効果の約束など、医療広告のルールで制限される内容が含まれています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب شيئاً تقيّده قواعد الإعلان الصحي، مثل الأسعار أو العروض أو المقارنات أو النتائج الموعودة."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy czegoś, co ograniczają zasady reklamy usług medycznych, np. cen, promocji, porównań lub obiecanych efektów."
          }
        }
      }
    },
    "topics.reason.checks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We wrote it, but the script didn't pass our clinical and advertising checks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben es geschrieben, aber das Skript hat unsere fachliche und werberechtliche Prüfung nicht bestanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo escribimos, pero el guion no pasó nuestras revisiones clínicas y de publicidad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırladık, ancak metin klinik ve reklam kontrollerimizden geçmedi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous l'avons rédigé, mais le script n'a pas passé nos vérifications cliniques et publicitaires."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原稿は作成しましたが、医学的な正確さと広告ルールのチェックを通りませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتبناه، لكن النص لم يجتز مراجعاتنا السريرية والإعلانية."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowaliśmy go, ale scenariusz nie przeszedł naszych kontroli klinicznych i reklamowych."
          }
        }
      }
    },
    "topics.reason.clinical": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't turn it into general, mainstream guidance. It may need an individual diagnosis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten daraus keinen allgemeinen, fachlich anerkannten Rat machen. Vermutlich braucht es eine individuelle Diagnose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos convertirlo en una orientación general y aceptada. Puede que necesite un diagnóstico individual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu genel ve yerleşik bir bilgilendirmeye dönüştüremedik. Kişiye özel muayene gerektirebilir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu en faire un conseil général et reconnu. Il nécessite peut-être un diagnostic individuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一般的で標準的な情報としてまとめられませんでした。個別の診断が必要な内容かもしれません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكن من تحويله إلى إرشاد عام ومعتمد. قد يحتاج إلى تشخيص فردي."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się z tego zrobić ogólnej, uznanej informacji. Może to wymagać indywidualnej diagnozy."
          }
        }
      }
    },
    "topics.reason.not_offered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't about one of the services in your settings. Add the service, then suggest it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es betrifft keine der Leistungen in Ihren Einstellungen. Ergänzen Sie die Leistung und schlagen Sie es dann erneut vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No trata de ninguno de los servicios de tus ajustes. Añade el servicio y vuelve a proponerlo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınızdaki hizmetlerden biriyle ilgili değil. Hizmeti ekleyip yeniden önerin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne concerne aucun des soins de vos réglages. Ajoutez le soin, puis proposez-le à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定にある診療内容のどれにも当てはまりません。診療内容を追加してから、もう一度ご提案ください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتعلق بأيٍّ من الخدمات المسجّلة في إعداداتكم. أضيفوا الخدمة ثم اقترحوه من جديد."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie dotyczy żadnego z zabiegów w ustawieniach. Prosimy dodać zabieg i zaproponować temat ponownie."
          }
        }
      }
    },
    "topics.reason.unclear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't tell what the video should answer. Try writing it as a patient's question."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten nicht erkennen, was das Video beantworten soll. Formulieren Sie es am besten als Frage eines Patienten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No supimos qué debía responder el vídeo. Prueba a escribirlo como la pregunta de un paciente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Videonun neyi yanıtlaması gerektiğini anlayamadık. Bir hasta sorusu olarak yazmayı deneyin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas compris à quoi la vidéo devait répondre. Essayez de l'écrire comme la question d'un patient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画で何に答えればよいか分かりませんでした。患者さんの質問の形で書いてみてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتبيّن ما الذي ينبغي أن يجيب عنه الفيديو. جرّبوا كتابته على هيئة سؤال من مريض."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wiemy, na co film miałby odpowiadać. Warto zapisać to jako pytanie pacjenta."
          }
        }
      }
    },
    "topics.sending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird gesendet …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderiliyor…"
