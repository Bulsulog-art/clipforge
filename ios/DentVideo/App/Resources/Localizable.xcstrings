    "signup.signInNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is ready. Sign in with the same email and password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto ist bereit. Melden Sie sich mit derselben E-Mail-Adresse und demselben Passwort an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta está lista. Inicia sesión con el mismo correo y la misma contraseña."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız hazır. Aynı e-posta ve şifreyle giriş yapın."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est prêt. Connectez-vous avec le même e-mail et le même mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの準備ができました。同じメールアドレスとパスワードでログインしてください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسابكم جاهز. سجّلوا الدخول بالبريد الإلكتروني وكلمة المرور نفسيهما."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto jest gotowe. Prosimy zalogować się tym samym adresem e-mail i hasłem."
          }
        }
      }
    },
    "signup.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your clinic's email address. We'll send a 6-digit code to confirm it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die E-Mail-Adresse Ihrer Praxis. Wir senden Ihnen einen 6-stelligen Code zur Bestätigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el correo de tu clínica. Te enviaremos un código de 6 dígitos para confirmarlo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliniğinizin e-posta adresini kullanın. Doğrulamak için 6 haneli bir kod göndereceğiz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'adresse e-mail de votre cabinet. Nous vous enverrons un code à 6 chiffres pour la confirmer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医院のメールアドレスをご利用ください。確認のため6桁のコードをお送りします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدموا البريد الإلكتروني لعيادتكم. سنرسل رمزاً من 6 أرقام لتأكيده."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosimy użyć adresu e-mail gabinetu. Wyślemy 6-cyfrowy kod, aby go potwierdzić."
          }
        }
      }
    },
